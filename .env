# Enable development behavior for commands that import the app directly
FASTAPI_ENV=development

PROJECT_NAME="Onebros Local"

SECRET_KEY=secret123
FIRST_SUPERUSER=admin@local.com
FIRST_SUPERUSER_PASSWORD=secret123

# Emails
SMTP_HOST=localhost
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=False
SMTP_PORT=1025

# Postgres
POSTGRES_PASSWORD=secret
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5432/app
